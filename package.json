{
  "name": "dsh-whale-pet",
  "version": "0.1.1",
  "private": true,
  "license": "Apache-2.0",
  "author": "gorkaseto",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gorkaseto/dsh-whale-pet.git"
  },
  "homepage": "https://github.com/Gorkaseto/dsh-whale-pet#readme",
  "description": "Animated pixel-art whale pet sitting on top of the composer in a new session",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE", "NOTICE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
